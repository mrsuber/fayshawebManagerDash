# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fayshaa
DB_USER=fayshaauser
DB_PASSWORD=change-me

# Firebase Configuration
FIREBASE_PROJECT_ID=fayshaa-5cac6
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# JWT Configuration (for authentication)
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# API Configuration
API_PREFIX=/api
# Extra origins allowed to call the API from a browser (comma-separated); fayshaa.com and www.fayshaa.com are built in
CORS_ORIGIN=

# Rate limiting per IP and window. The dashboards make many requests per screen: keep the general limit high.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=3000
# Sign-in, sign-up and password reset attempts per IP and window
AUTH_RATE_LIMIT_MAX=30

# How long an unpaid booking holds its residence: card checkouts (minutes), mobile money awaiting staff (hours)
CARD_HOLD_MINUTES=60
MOBILE_MONEY_HOLD_HOURS=48

# First super administrator created by `node db/setup.js` (only when there is none)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Manager dashboard (FAY OS, /api/manager)
# Property time zone for wall-clock dates and times (dining, wellness, transfers).
PROPERTY_TZ=Africa/Douala
# Optional: FAY AI answers with Claude; without it the AI Command Center uses a built-in summary.
ANTHROPIC_API_KEY=
# Optional: lets the n8n AI concierge post replies with the header x-fay-callback-secret instead of a staff JWT.
N8N_CALLBACK_SECRET=
# Set to true once every guest-app build sends its token on socket connect.
SOCKET_REQUIRE_AUTH=false

# Guest app: the residence Wi-Fi shown with the digital key (only to guests with a confirmed stay)
PROPERTY_WIFI_SSID=
PROPERTY_WIFI_PASSWORD=

# Website contact form recipient (defaults to EMAIL_FROM)
CONTACT_EMAIL=

# Public site address (links in emails) and app store links shown in booking emails
APP_URL=https://fayshaa.com
IOS_APP_URL=
ANDROID_APP_URL=

# Payments. Paste the keys in HQ → Settings → Payments (stored encrypted, applied at once). The variables below
# are only a fallback for servers set up before that page existed; keys saved in Settings win.
# Encrypts the saved keys (defaults to JWT_SECRET). If it changes, paste the keys again.
SETTINGS_ENCRYPTION_KEY=
# Cards (Stripe). The webhook secret is required in production: unsigned webhook events are rejected.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Mobile money (PayWithCAMSOL / SuberPay, MTN and Orange in XAF). Without keys, outside production, payments are
# simulated (they succeed after CAMSOL_FAKE_CONFIRM_SECONDS; numbers ending 600000001 fail). CAMSOL_MODE=live
# turns simulation off everywhere.
CAMSOL_SECRET_KEY=
CAMSOL_WEBHOOK_SECRET=
CAMSOL_BASE_URL=https://paywithcamsol.com
CAMSOL_MODE=
CAMSOL_FAKE_CONFIRM_SECONDS=5
# How often pending mobile money payments are checked, in seconds
FINANCE_POLL_SECONDS=30
# Public address of the API, used for the webhook addresses shown in Settings (defaults to APP_URL + /api)
PUBLIC_API_URL=

# Outgoing email (booking confirmations, digital keys, password resets, contact form)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=Faysha Wellness Residence

# Optional: model for FAY AI (defaults to claude-opus-5-5)
ANTHROPIC_MODEL=

# Operations monitor (late check-outs, waiting requests and guests, events…). Runs every minute; set true to turn it off.
MONITOR_DISABLED=

# Gate controller (optional). When set, "Open gate" in FAY OS → Visitors & Gate POSTs { action: 'open', gate, passId, by }
# here with the header x-gate-secret; without it, openings are recorded and the guard opens the gate.
GATE_WEBHOOK_URL=
GATE_WEBHOOK_SECRET=
