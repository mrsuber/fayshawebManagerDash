# Copy to .env (or .env.local). CRA only exposes REACT_APP_* variables, inlined at build time.

# API base URL. Leave empty to use /api in production and http://localhost:5001/api on localhost.
REACT_APP_API_URL=

# Development only: run the website and the manager dashboard on built-in sample data (no backend).
# Production builds always use the API.
REACT_APP_USE_MOCKS=false

# Stripe publishable key — enables card payments in the booking flow (the secret key stays on the backend).
REACT_APP_STRIPE_PUBLISHABLE_KEY=

# Firebase web app (manager dashboard push notifications). These values are public by design.
REACT_APP_FIREBASE_API_KEY=AIzaSyBQDLH0RUmVReCqCbAA35spGp3G8RPhmWw
REACT_APP_FIREBASE_AUTH_DOMAIN=fayshaa-5cac6.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=fayshaa-5cac6
REACT_APP_FIREBASE_STORAGE_BUCKET=fayshaa-5cac6.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=4772941120
REACT_APP_FIREBASE_APP_ID=1:4772941120:web:b956e610dc8fc8813f3ea5
REACT_APP_FIREBASE_MEASUREMENT_ID=G-FS8WBNH9VH
# Firebase Console → Cloud Messaging → Web Push certificates
REACT_APP_FIREBASE_VAPID_KEY=
