# Copy to .env (or .env.local) and fill in. CRA only exposes variables prefixed with REACT_APP_.

# Express API base URL (include /api). Leave empty in development to use the CRA proxy
# ("proxy" in package.json → http://localhost:5000) with relative /api calls.
REACT_APP_API_URL=
# Socket.io server; defaults to the API origin.
REACT_APP_SOCKET_URL=
# true = run on built-in sample data (no backend). Defaults to true when REACT_APP_API_URL is empty.
REACT_APP_USE_MOCKS=true

# Stripe publishable key (the secret key stays on the backend).
REACT_APP_STRIPE_PUBLISHABLE_KEY=
REACT_APP_CURRENCY=usd

# Firebase web app config (Google sign-in + push notifications).
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
# Web push certificate key (Firebase console → Cloud Messaging → Web configuration).
REACT_APP_FIREBASE_VAPID_KEY=
