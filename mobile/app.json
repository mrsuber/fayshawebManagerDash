{
  "expo": {
    "name": "Faysha",
    "slug": "faysha",
    "scheme": "faysha",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D0D0D",
    "primaryColor": "#C8A45D",
    "description": "Faysha Wellness Residence: your stay, your residence and every service in one place.",
    "ios": {
      "bundleIdentifier": "com.fayshaa.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Faysha uses your photos when you share a picture with the concierge.",
        "NSCameraUsageDescription": "Faysha uses the camera when you share a picture with the concierge.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fayshaa.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#0D0D0D"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C8A45D"
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": false
        }
      ],
      "expo-font"
    ],
    "extra": {
      "apiUrl": "https://fayshaa.com/api",
      "stripePublishableKey": "pk_test_51JLaHtBBZYlnWgxJEWpAoMZwh0wQPlafhJabaSASYYqiajF40exKqHTKmErb2ButSJRwgHdfxOuqfjNzy8yVTPvz00SF3r6UZj",
      "eas": {}
    }
  }
}
